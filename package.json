{
  "name": "c-and-assess",
  "version": "1.0.0",
  "description": "A full-stack online assessment and post-test analytics platform built for the Consulting & Analytics Club, IIT Guwahati.",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "test:scoring": "node --experimental-strip-types scripts/verify_scoring.mjs",
    "test:schema": "python scripts/verify_schema.py",
    "test:load": "node --experimental-strip-types scripts/load_test_results.ts",
    "test:load:http": "node scripts/load_test_http.mjs",
    "check": "npm run typecheck && npm run lint && npm run test:scoring && npm run test:schema && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hermes-25/c-and-assess.git"
  },
  "homepage": "https://assess.caciitg.com",
  "bugs": {
    "url": "https://github.com/Hermes-25/c-and-assess/issues"
  },
  "author": "Abhishek Das",
  "license": "MIT",
  "dependencies": {
    "@types/papaparse": "^5.5.2",
    "drizzle-orm": "0.45.2",
    "jszip": "^3.10.1",
    "next": "^16.3.3",
    "papaparse": "^5.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
